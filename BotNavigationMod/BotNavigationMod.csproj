<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BotNavigationMod</AssemblyName>
    <RootNamespace>BotNavigationMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    Install root (trailing slash). Do NOT hardcode machine paths in this file.
    Resolve order:
      1) -p:TarkovDir="C:\Path\To\EscapeFromTarkov\"
      2) env SPT_TARKOV_DIR
      3) optional Directory.Build.props.user (gitignored)
  -->
  <PropertyGroup>
    <TarkovDir Condition="'$(TarkovDir)' == '' and '$(SPT_TARKOV_DIR)' != ''">$(SPT_TARKOV_DIR)</TarkovDir>
  </PropertyGroup>

  <Target Name="RequireTarkovDir" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(TarkovDir)' == ''"
      Text="TarkovDir is unset. Pass -p:TarkovDir=&quot;C:\Path\To\EscapeFromTarkov\&quot; or set env SPT_TARKOV_DIR (trailing slash)." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(TarkovDir)EscapeFromTarkov_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(TarkovDir)BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(TarkovDir)BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(TarkovDir)' != ''">
    <MakeDir Directories="$(TarkovDir)BepInEx\plugins\BotNavigationMod\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TarkovDir)BepInEx\plugins\BotNavigationMod\" />
  </Target>
</Project>
